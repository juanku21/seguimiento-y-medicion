{
  "permissions": {
    "allow": [
      "mcp__github__list_issues",
      "mcp__github__issue_read",
      "mcp__github__list_label",
      "mcp__github__label_write",
      "mcp__github__issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__sub_issue_write"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -m:*)",
      "mcp__github__merge_pull_request",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.test)"
    ]
  }
}
