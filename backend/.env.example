# Plantilla versionada de variables de la aplicación backend. Copiar como .env (desarrollo) y
# .env.test (test, con DB_PORT=5433 y DB_NAME=smye_test) y reemplazar los valores de ejemplo.
# Conexión a PostgreSQL: DB_PASSWORD debe coincidir con POSTGRES_PASSWORD de backend/postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=smye
DB_PASSWORD=cambiar_este_valor
DB_NAME=smye_dev
# Alternativa a las cinco variables DB_*: una URL de conexión completa, que tiene prioridad sobre
# ellas. En producción es la Internal Database URL de Render. No se usa en desarrollo ni en test.
# DATABASE_URL=postgres://usuario:contraseña@host:5432/base
# Secreto de firma de los JWT (HS256): al menos 32 bytes; generar con `openssl rand -hex 32`.
JWT_SECRET=cambiar_por_un_secreto_de_al_menos_32_bytes
# Puerto HTTP de la API y origen del frontend habilitado por CORS.
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Zona horaria IANA del sistema, usada para fijar fechas de calendario (por ejemplo, la fecha de
# finalización real de un proyecto). Si falta o no es válida, la aplicación no arranca.
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Plazo de gracia, en horas enteras, para registrar y corregir esfuerzo después de cerrar un sprint (por defecto 48)
EFFORT_GRACE_PERIOD_HOURS=48
