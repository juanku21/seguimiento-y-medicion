# Plantilla versionada de variables de la aplicación backend. Copiar como .env (desarrollo) y
# .env.test (test, con DB_PORT=5433 y DB_NAME=smye_test) y reemplazar los valores de ejemplo.
# Conexión a PostgreSQL: DB_PASSWORD debe coincidir con POSTGRES_PASSWORD de backend/postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=smye
DB_PASSWORD=cambiar_este_valor
DB_NAME=smye_dev
# Secreto de firma de los JWT (HS256): al menos 32 bytes; generar con `openssl rand -hex 32`.
JWT_SECRET=cambiar_por_un_secreto_de_al_menos_32_bytes
# Puerto HTTP de la API y origen del frontend habilitado por CORS.
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:3000
