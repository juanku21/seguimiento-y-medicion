# Plantilla versionada de variables de PostgreSQL. Copiar como .env (desarrollo) y .env.test (test,
# con POSTGRES_DB=smye_test y POSTGRES_HOST_PORT=5433) y reemplazar la contraseña por un valor propio.
# Credenciales del superusuario que crea la imagen de PostgreSQL al inicializar el volumen.
POSTGRES_USER=smye
POSTGRES_PASSWORD=cambiar_este_valor
# Nombre de la base que se crea al primer arranque.
POSTGRES_DB=smye_dev
# Puerto del host publicado hacia el 5432 del contenedor.
POSTGRES_HOST_PORT=5432
